{
  "name": "netlab",
  "version": "0.1.0",
  "description": "Browser-based network visualization library with OSI layer simulation",
  "main": "dist/netlab.cjs.js",
  "module": "dist/netlab.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.css",
    "dist/**/*.d.ts",
    "bin/*.mjs"
  ],
  "sideEffects": [
    "./dist/layers/*/index.js",
    "./dist/layers/*/index.cjs.js",
    "./src/layers/*/index.ts",
    "./src/layers/registerAllLayers.ts",
    "./src/layers/registerForwarders.ts",
    "./src/sandbox/edits/*.ts",
    "./src/scenarios/index.ts",
    "./src/tutorials/index.ts"
  ],
  "bin": {
    "netlab-run": "bin/netlab-run.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/netlab.es.js",
      "require": "./dist/netlab.cjs.js"
    },
    "./layers/l1-physical": {
      "types": "./dist/layers/l1-physical/index.d.ts",
      "import": "./dist/layers/l1-physical/index.js",
      "require": "./dist/layers/l1-physical/index.cjs.js"
    },
    "./layers/l2-datalink": {
      "types": "./dist/layers/l2-datalink/index.d.ts",
      "import": "./dist/layers/l2-datalink/index.js",
      "require": "./dist/layers/l2-datalink/index.cjs.js"
    },
    "./layers/l3-network": {
      "types": "./dist/layers/l3-network/index.d.ts",
      "import": "./dist/layers/l3-network/index.js",
      "require": "./dist/layers/l3-network/index.cjs.js"
    },
    "./layers/l4-transport": {
      "types": "./dist/layers/l4-transport/index.d.ts",
      "import": "./dist/layers/l4-transport/index.js",
      "require": "./dist/layers/l4-transport/index.cjs.js"
    },
    "./layers/l7-application": {
      "types": "./dist/layers/l7-application/index.d.ts",
      "import": "./dist/layers/l7-application/index.js",
      "require": "./dist/layers/l7-application/index.cjs.js"
    },
    "./protocols/tls": {
      "types": "./dist/protocols/tls/index.d.ts",
      "import": "./dist/protocols/tls/index.js",
      "require": "./dist/protocols/tls/index.cjs.js"
    },
    "./protocols/quic": {
      "types": "./dist/protocols/quic/index.d.ts",
      "import": "./dist/protocols/quic/index.js",
      "require": "./dist/protocols/quic/index.cjs.js"
    },
    "./protocols/http2": {
      "types": "./dist/protocols/http2/index.d.ts",
      "import": "./dist/protocols/http2/index.js",
      "require": "./dist/protocols/http2/index.cjs.js"
    },
    "./protocols/http3": {
      "types": "./dist/protocols/http3/index.d.ts",
      "import": "./dist/protocols/http3/index.js",
      "require": "./dist/protocols/http3/index.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "size": "npm run build && size-limit",
    "size:delta": "node scripts/size-limit-delta.mjs",
    "size:comment": "node scripts/post-pr-comment.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "soak:test": "node scripts/soak-test.mjs",
    "changelog:gen": "node scripts/changelog-gen.mjs",
    "bench:forwarding": "node scripts/bench-forwarding.mjs",
    "bench:tls": "node scripts/bench-tls.mjs",
    "bench:h2-h3": "node scripts/bench-h2-h3.mjs",
    "regression": "npm run build:cli && node scripts/run-regression-matrix.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook --url http://127.0.0.1:6006",
    "plan:index": "node scripts/build-plan-index.mjs",
    "plan:index:check": "node scripts/build-plan-index.mjs --check",
    "tree-shake:check": "node scripts/measure-tree-shake.mjs",
    "tarball:check": "node scripts/check-published-tarball.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@storybook/test-runner": "0.24.3",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "axe-playwright": "2.2.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.14.0",
    "size-limit": "^12.1.0",
    "storybook": "10.3.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.7",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@maxgraph/core": "0.24.0",
    "zustand": "^5.0.0"
  },
  "keywords": [
    "network",
    "visualization",
    "osi",
    "react-flow",
    "simulation",
    "packet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koseki2580/netlab"
  }
}
